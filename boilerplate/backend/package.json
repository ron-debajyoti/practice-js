{
  "name": "react-express-boilerplate-backend",
  "version": "1.0.0",
  "description": "Express.js backend for React-Express boilerplate",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "build": "tsc",
    "start:js": "node dist/server.js",
    "dev:js": "nodemon dist/server.js"
  },
  "keywords": [
    "express",
    "nodejs",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.8.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
